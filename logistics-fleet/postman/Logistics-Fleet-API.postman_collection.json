{
  "info": {
    "name": "Logistics & Fleet Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run '1 \u00b7 Auth' logins first; each login stores {{token}}. For the shipment flow, log in as the role named in each request (or use the per-role tokens)."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const pad = n => String(n).padStart(2, '0');",
          "const d = new Date(); const iso = x => `${x.getFullYear()}-${pad(x.getMonth()+1)}-${pad(x.getDate())}`;",
          "const isoT = x => `${iso(x)}T${pad(x.getHours())}:${pad(x.getMinutes())}:00`;",
          "pm.collectionVariables.set('today', iso(d));",
          "pm.collectionVariables.set('inOneHour', isoT(new Date(Date.now() + 3600000)));",
          "pm.collectionVariables.set('tomorrow', isoT(new Date(Date.now() + 86400000)));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
